# ============================================
# AH6 Cricket Live Score - Root .gitignore
# ============================================

# Node modules (all sub-projects)
node_modules/
**/node_modules/

# Environment variables - NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Build output
dist/
build/
**/dist/
**/build/

# Database files
*.sqlite
*.db
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# IDE
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Railway / Vercel
.railway/
.vercel/

# Lock files (optional - uncomment if you want to ignore)
# package-lock.json
# yarn.lock
