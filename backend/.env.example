# Database - Railway provides this automatically when PostgreSQL plugin is added
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret - generate a random string, e.g.: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_this

# Scorer login credentials (single shared account)
SCORER_EMAIL=scorer@ah6cricket.com
SCORER_PASSWORD=AH6Cricket@2026

# Server port (Railway sets this automatically)
PORT=3001

# CORS - comma-separated list of allowed frontend origins
# Example: https://ah6-scorer.vercel.app,https://ah6-public.vercel.app
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# Environment
NODE_ENV=development
